<?xml version="1.0" encoding="UTF-8"?>
<mdscript name="jobRegistryDialogue" debug="true">
  <cues>
    <cue name="AddJobRegistryConversationChoice" instantiate="true" namespace="this">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <add_player_choice_sub text="{75200, 1}" section="openRegistry" />
      </actions>
    </cue>

    <cue name="RegisterJobRegistryConversationOption" instantiate="true" namespace="this">
      <conditions>
        <check_any>
          <event_conversation_started conversation="default" />
          <event_conversation_returned_to_section section="default" />
        </check_any>
        <check_value value="typeof event.object == datatype.component and event.object.controlpost == controlpost.manager and @event.object.station.exists" />
      </conditions>
      <actions>
        <do_if value="@md.ExtendedConversationMenu.Main.exists">
          <set_value name="md.ExtendedConversationMenu.Main.$convOptions.$JobRegistryConversationOption" exact="table[ $signalCue = AddJobRegistryConversationChoice, $params = [] ]"/>
        </do_if>
        <do_else>
          <signal_cue_instantly cue="AddJobRegistryConversationChoice"/>
        </do_else>
      </actions>
    </cue>
    <cue name="openRegistry" instantiate="true" namespace="this">
      <conditions>
        <event_conversation_next_section section="openRegistry" />
      </conditions>
      <actions>
        <set_value name="$station" exact="event.object.station" />
        <do_if value="$station">
          <open_conversation_menu menu="Arckame_JobRegistry_Menu" param="[$station]" />
        </do_if>
        <do_else>
          <debug_text text="'Job Registry could not find a station for this conversation'" filter="error" />
        </do_else>
      </actions>
    </cue>
  </cues>
</mdscript>
